{
  "id": "omnivoice",
  "service": "tts",
  "title": "OmniVoice",
  "order": 30,
  "description": "Многоязычный синтез k2-fsa/OmniVoice (Xiaomi, Apache-2.0): клонирование голоса по эталону 3–10 с или голос по текстовому описанию. ~1,3 ГБ видеопамяти; модель скачивается при первом запуске.",
  "requirements": {
    "gpu": true,
    "vram_gb": 2,
    "disk_gb": 5
  },
  "adapter": "openai",
  "config": {
    "url": "http://127.0.0.1:{port}/v1/audio/speech",
    "model": "omnivoice",
    "voice": "reference",
    "response_format": "pcm_f32le"
  },
  "fields": [
    {
      "key": "device",
      "label": "Устройство",
      "type": "select",
      "options": [
        {
          "value": "cpu",
          "label": "Процессор (CPU)"
        },
        {
          "value": "cuda",
          "label": "Видеокарта NVIDIA (CUDA)"
        }
      ]
    },
    {
      "key": "gpu",
      "label": "Видеокарта",
      "type": "select",
      "options_from": "gpus",
      "when": {
        "device": "cuda"
      }
    },
    {
      "key": "threads",
      "label": "Потоков процессора",
      "type": "number",
      "step": 1,
      "when": {
        "device": "cpu"
      },
      "group": "advanced"
    },
    {
      "key": "priority",
      "label": "Приоритет процесса",
      "type": "select",
      "options": [
        {
          "value": "normal",
          "label": "Обычный"
        },
        {
          "value": "low",
          "label": "Низкий (фоновый)"
        }
      ],
      "group": "advanced"
    },
    {
      "key": "ref_audio",
      "label": "Эталонная запись голоса (WAV, 3–10 с лучше всего)",
      "type": "file",
      "accept": ".wav",
      "transcribe_to": "ref_text",
      "required": true,
      "when": {
        "voice_mode": "baked"
      }
    },
    {
      "key": "ref_text",
      "label": "Текст эталонной записи (пусто — распознаётся при сохранении)",
      "type": "textarea",
      "when": {
        "voice_mode": "baked"
      }
    },
    {
      "key": "voice_gender",
      "label": "Пол голоса",
      "type": "select",
      "options": [
        {
          "value": "female",
          "label": "Женский"
        },
        {
          "value": "male",
          "label": "Мужской"
        }
      ],
      "when": {
        "voice_mode": "preset"
      }
    },
    {
      "key": "voice_age",
      "label": "Возраст",
      "type": "select",
      "options": [
        {
          "value": "",
          "label": "Любой"
        },
        {
          "value": "child",
          "label": "Ребёнок"
        },
        {
          "value": "teenager",
          "label": "Подросток"
        },
        {
          "value": "young adult",
          "label": "Молодой"
        },
        {
          "value": "middle-aged",
          "label": "Средних лет"
        },
        {
          "value": "elderly",
          "label": "Пожилой"
        }
      ],
      "when": {
        "voice_mode": "preset"
      }
    },
    {
      "key": "voice_pitch",
      "label": "Высота голоса",
      "type": "select",
      "options": [
        {
          "value": "",
          "label": "Обычная"
        },
        {
          "value": "very low pitch",
          "label": "Очень низкая"
        },
        {
          "value": "low pitch",
          "label": "Низкая"
        },
        {
          "value": "moderate pitch",
          "label": "Средняя"
        },
        {
          "value": "high pitch",
          "label": "Высокая"
        },
        {
          "value": "very high pitch",
          "label": "Очень высокая"
        }
      ],
      "when": {
        "voice_mode": "preset"
      }
    },
    {
      "key": "voice_accent",
      "label": "Акцент",
      "type": "select",
      "options": [
        {
          "value": "",
          "label": "Без акцента"
        },
        {
          "value": "russian accent",
          "label": "Русский"
        },
        {
          "value": "british accent",
          "label": "Британский"
        },
        {
          "value": "american accent",
          "label": "Американский"
        },
        {
          "value": "australian accent",
          "label": "Австралийский"
        },
        {
          "value": "canadian accent",
          "label": "Канадский"
        },
        {
          "value": "indian accent",
          "label": "Индийский"
        },
        {
          "value": "chinese accent",
          "label": "Китайский"
        },
        {
          "value": "japanese accent",
          "label": "Японский"
        },
        {
          "value": "korean accent",
          "label": "Корейский"
        },
        {
          "value": "portuguese accent",
          "label": "Португальский"
        }
      ],
      "when": {
        "voice_mode": "preset"
      },
      "group": "advanced"
    },
    {
      "key": "voice_style",
      "label": "Манера",
      "type": "select",
      "options": [
        {
          "value": "",
          "label": "Обычная"
        },
        {
          "value": "whisper",
          "label": "Шёпот"
        }
      ],
      "when": {
        "voice_mode": "preset"
      },
      "group": "advanced"
    },
    {
      "key": "language",
      "label": "Язык",
      "type": "text",
      "group": "advanced"
    },
    {
      "key": "speed",
      "label": "Скорость речи",
      "type": "number",
      "step": 0.1
    },
    {
      "key": "steps",
      "label": "Шагов генерации (качество/время)",
      "type": "number",
      "step": 1,
      "group": "advanced"
    },
    {
      "key": "port",
      "label": "Порт",
      "type": "number",
      "step": 1,
      "group": "advanced"
    }
  ],
  "defaults": {
    "device": "cuda",
    "gpu": "0",
    "threads": 4,
    "priority": "normal",
    "ref_audio": "",
    "ref_text": "",
    "language": "ru",
    "speed": 1.0,
    "steps": 32,
    "port": 8778,
    "voice_gender": "female",
    "voice_age": "",
    "voice_pitch": "",
    "voice_accent": "",
    "voice_style": ""
  },
  "server": {
    "script": "tools/omnivoice_server.py",
    "health": "/health",
    "env": {
      "OV_DEVICE": "{device}",
      "OV_THREADS": "{threads}",
      "OV_REF_AUDIO": "{ref_audio}",
      "OV_REF_TEXT": "{ref_text}",
      "OV_INSTRUCT": "{voice_gender}, {voice_age}, {voice_pitch}, {voice_accent}, {voice_style}",
      "OV_LANGUAGE": "{language}",
      "OV_SPEED": "{speed}",
      "OV_STEPS": "{steps}",
      "CUDA_VISIBLE_DEVICES": "{gpu}"
    }
  },
  "platforms": {
    "windows": {
      "cuda": [
        {
          "pip": [
            "torch",
            "torchaudio"
          ],
          "args": [
            "--index-url",
            "https://download.pytorch.org/whl/cu126"
          ]
        },
        {
          "pip": [
            "omnivoice",
            "soundfile",
            "aiohttp"
          ]
        }
      ],
      "cpu": [
        {
          "pip": [
            "torch",
            "torchaudio"
          ],
          "args": [
            "--index-url",
            "https://download.pytorch.org/whl/cpu"
          ]
        },
        {
          "pip": [
            "omnivoice",
            "soundfile",
            "aiohttp"
          ]
        }
      ]
    },
    "linux": {
      "cuda": [
        {
          "pip": [
            "torch",
            "torchaudio"
          ],
          "args": [
            "--index-url",
            "https://download.pytorch.org/whl/cu126"
          ]
        },
        {
          "pip": [
            "omnivoice",
            "soundfile",
            "aiohttp"
          ]
        }
      ],
      "cpu": [
        {
          "pip": [
            "torch",
            "torchaudio"
          ],
          "args": [
            "--index-url",
            "https://download.pytorch.org/whl/cpu"
          ]
        },
        {
          "pip": [
            "omnivoice",
            "soundfile",
            "aiohttp"
          ]
        }
      ]
    }
  },
  "notes": {
    "windows": "Нужен драйвер NVIDIA с поддержкой CUDA 12.6.",
    "linux": "Нужен драйвер NVIDIA с поддержкой CUDA 12.6."
  },
  "models": [],
  "reinstall_on": [
    "device"
  ],
  "voice_modes": [
    "preset",
    "baked"
  ],
  "bake": {
    "audio": "ref_audio",
    "text": "ref_text",
    "mode": "baked"
  }
}
