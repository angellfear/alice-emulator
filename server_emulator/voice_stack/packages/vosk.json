{
  "id": "vosk",
  "service": "asr",
  "title": "Vosk (CPU)",
  "order": 50,
  "description": "Лёгкое распознавание речи Vosk (Kaldi, Apache-2.0) на процессоре, без интернета. Small (45 МБ) — быстро и почти без нагрузки, но качество заметно ниже; серверная модель ru-0.42 (1,8 ГБ) точнее, но занимает много оперативной памяти. Текст без знаков препинания, строчными буквами.",
  "requirements": {
    "gpu": false,
    "vram_gb": 0,
    "disk_gb": 3
  },
  "adapter": "openai",
  "config": {
    "url": "http://127.0.0.1:{port}/v1/audio/transcriptions",
    "model": "vosk-model-{model}",
    "language": "ru"
  },
  "fields": [
    {
      "key": "model",
      "label": "Модель",
      "type": "select",
      "options": [
        {
          "value": "small-ru-0.22",
          "label": "Small: 45 МБ, быстрая, качество ниже"
        },
        {
          "value": "ru-0.42",
          "label": "Серверная: 1,8 ГБ, точнее, много памяти"
        }
      ]
    },
    {
      "key": "workers",
      "label": "Потоков распознавания (параллельных запросов)",
      "type": "number",
      "step": 1,
      "group": "advanced"
    },
    {
      "key": "priority",
      "label": "Приоритет процесса",
      "type": "select",
      "options": [
        {
          "value": "normal",
          "label": "Обычный"
        },
        {
          "value": "low",
          "label": "Низкий (фоновый)"
        }
      ],
      "group": "advanced"
    },
    {
      "key": "port",
      "label": "Порт",
      "type": "number",
      "step": 1,
      "group": "advanced"
    }
  ],
  "defaults": {
    "model": "small-ru-0.22",
    "workers": 2,
    "priority": "normal",
    "port": 5018
  },
  "server": {
    "script": "tools/vosk_server.py",
    "health": "/health",
    "env": {
      "VOSK_MODEL": "vosk-model-{model}",
      "VOSK_MODEL_DIR": "{dir}/vosk-model-{model}",
      "VOSK_WORKERS": "{workers}"
    }
  },
  "platforms": {
    "windows": {
      "cpu": [
        {
          "pip": [
            "vosk==0.3.45",
            "numpy==2.5.4",
            "aiohttp==3.14.5",
            "soundfile==0.14.0",
            "soxr==1.1.0"
          ]
        }
      ]
    },
    "linux": {
      "cpu": [
        {
          "pip": [
            "vosk==0.3.45",
            "numpy==2.5.4",
            "aiohttp==3.14.5",
            "soundfile==0.14.0",
            "soxr==1.1.0"
          ]
        }
      ]
    }
  },
  "models": [
    {
      "url": "https://alphacephei.com/vosk/models/vosk-model-{model}.zip"
    }
  ],
  "reinstall_on": [
    "model"
  ]
}
