{
  "id": "gigaam",
  "service": "asr",
  "title": "GigaAM v3 (CPU | GPU)",
  "order": 20,
  "description": "Лучшее открытое распознавание русской речи: GigaAM v3 от Сбера (MIT) на onnx-asr, без интернета. Вариант E2E сам ставит знаки препинания и пишет числа цифрами. Модель ~230 МБ (int8) скачивается при установке; на процессоре работает быстрее реального времени, видеокарта не обязательна.",
  "requirements": {
    "gpu": false,
    "vram_gb": 0,
    "disk_gb": 3
  },
  "adapter": "openai",
  "config": {
    "url": "http://127.0.0.1:{port}/v1/audio/transcriptions",
    "model": "gigaam-v3-{variant}",
    "language": "ru"
  },
  "fields": [
    {
      "key": "variant",
      "label": "Вариант модели",
      "type": "select",
      "options": [
        {
          "value": "e2e-rnnt",
          "label": "E2E RNN-T: пунктуация, числа цифрами (лучшая)"
        },
        {
          "value": "e2e-ctc",
          "label": "E2E CTC: пунктуация, быстрее"
        },
        {
          "value": "rnnt",
          "label": "RNN-T: без пунктуации"
        },
        {
          "value": "ctc",
          "label": "CTC: без пунктуации, самая быстрая"
        }
      ]
    },
    {
      "key": "device",
      "label": "Устройство",
      "type": "select",
      "options": [
        {
          "value": "cpu",
          "label": "Процессор (CPU)"
        },
        {
          "value": "cuda",
          "label": "Видеокарта NVIDIA (CUDA)"
        }
      ]
    },
    {
      "key": "gpu",
      "label": "Видеокарта",
      "type": "select",
      "options_from": "gpus",
      "when": {
        "device": "cuda"
      }
    },
    {
      "key": "quantization",
      "label": "Точность весов",
      "type": "select",
      "options": [
        {
          "value": "auto",
          "label": "Авто: int8 на процессоре, fp32 на видеокарте"
        },
        {
          "value": "int8",
          "label": "int8: файлы меньше, на процессоре быстрее"
        },
        {
          "value": "fp32",
          "label": "fp32: чуть точнее, файлы больше"
        }
      ],
      "group": "advanced"
    },
    {
      "key": "threads",
      "label": "Потоков процессора",
      "type": "number",
      "step": 1,
      "group": "advanced"
    },
    {
      "key": "workers",
      "label": "Параллельных запросов",
      "type": "number",
      "step": 1,
      "group": "advanced"
    },
    {
      "key": "priority",
      "label": "Приоритет процесса",
      "type": "select",
      "options": [
        {
          "value": "normal",
          "label": "Обычный"
        },
        {
          "value": "low",
          "label": "Низкий (фоновый)"
        }
      ],
      "group": "advanced"
    },
    {
      "key": "port",
      "label": "Порт",
      "type": "number",
      "step": 1,
      "group": "advanced"
    }
  ],
  "defaults": {
    "variant": "e2e-rnnt",
    "device": "cpu",
    "gpu": "0",
    "quantization": "auto",
    "threads": 4,
    "workers": 2,
    "priority": "normal",
    "port": 5015
  },
  "server": {
    "script": "tools/gigaam_server.py",
    "health": "/health",
    "env": {
      "ASR_MODEL_VARIANT": "{variant}",
      "ASR_MODEL_DIR": "{dir}/gigaam-v3-{variant}",
      "ASR_VAD_DIR": "{dir}/silero-vad",
      "ASR_DEVICE": "{device}",
      "ASR_QUANT": "{quantization}",
      "ASR_THREADS": "{threads}",
      "ASR_WORKERS": "{workers}",
      "HF_HUB_OFFLINE": "1",
      "CUDA_VISIBLE_DEVICES": "{gpu}"
    }
  },
  "platforms": {
    "windows": {
      "cpu": [
        {
          "pip": [
            "onnx-asr[hub]==0.12.0",
            "huggingface-hub==2.4.0",
            "numpy==2.5.4",
            "aiohttp==3.14.5",
            "soundfile==0.14.0",
            "soxr==1.1.0",
            "onnxruntime==1.31.1"
          ]
        },
        {
          "run": [
            "{python}",
            "-c",
            "import sys, onnx_asr\nname, path, device, quant, vad = sys.argv[1:6]\nquantization = {'auto': None if device == 'cuda' else 'int8', 'int8': 'int8'}.get(quant)\ncpu = ['CPUExecutionProvider']\nonnx_asr.load_model(name, path, quantization=quantization, providers=cpu)\nonnx_asr.load_vad('silero', vad, providers=cpu)",
            "gigaam-v3-{variant}",
            "{dir}/gigaam-v3-{variant}",
            "{device}",
            "{quantization}",
            "{dir}/silero-vad"
          ],
          "title": "Загрузка модели и VAD"
        }
      ],
      "cuda": [
        {
          "pip": [
            "onnx-asr[hub]==0.12.0",
            "huggingface-hub==2.4.0",
            "numpy==2.5.4",
            "aiohttp==3.14.5",
            "soundfile==0.14.0",
            "soxr==1.1.0",
            "onnxruntime-gpu[cuda,cudnn]==1.24.4",
            "nvidia-cublas-cu12==12.8.4.1"
          ]
        },
        {
          "run": [
            "{python}",
            "-c",
            "import sys, onnx_asr\nname, path, device, quant, vad = sys.argv[1:6]\nquantization = {'auto': None if device == 'cuda' else 'int8', 'int8': 'int8'}.get(quant)\ncpu = ['CPUExecutionProvider']\nonnx_asr.load_model(name, path, quantization=quantization, providers=cpu)\nonnx_asr.load_vad('silero', vad, providers=cpu)",
            "gigaam-v3-{variant}",
            "{dir}/gigaam-v3-{variant}",
            "{device}",
            "{quantization}",
            "{dir}/silero-vad"
          ],
          "title": "Загрузка модели и VAD"
        }
      ]
    },
    "linux": {
      "cpu": [
        {
          "pip": [
            "onnx-asr[hub]==0.12.0",
            "huggingface-hub==2.4.0",
            "numpy==2.5.4",
            "aiohttp==3.14.5",
            "soundfile==0.14.0",
            "soxr==1.1.0",
            "onnxruntime==1.31.1"
          ]
        },
        {
          "run": [
            "{python}",
            "-c",
            "import sys, onnx_asr\nname, path, device, quant, vad = sys.argv[1:6]\nquantization = {'auto': None if device == 'cuda' else 'int8', 'int8': 'int8'}.get(quant)\ncpu = ['CPUExecutionProvider']\nonnx_asr.load_model(name, path, quantization=quantization, providers=cpu)\nonnx_asr.load_vad('silero', vad, providers=cpu)",
            "gigaam-v3-{variant}",
            "{dir}/gigaam-v3-{variant}",
            "{device}",
            "{quantization}",
            "{dir}/silero-vad"
          ],
          "title": "Загрузка модели и VAD"
        }
      ],
      "cuda": [
        {
          "pip": [
            "onnx-asr[hub]==0.12.0",
            "huggingface-hub==2.4.0",
            "numpy==2.5.4",
            "aiohttp==3.14.5",
            "soundfile==0.14.0",
            "soxr==1.1.0",
            "onnxruntime-gpu[cuda,cudnn]==1.24.4",
            "nvidia-cublas-cu12==12.8.4.1"
          ]
        },
        {
          "run": [
            "{python}",
            "-c",
            "import sys, onnx_asr\nname, path, device, quant, vad = sys.argv[1:6]\nquantization = {'auto': None if device == 'cuda' else 'int8', 'int8': 'int8'}.get(quant)\ncpu = ['CPUExecutionProvider']\nonnx_asr.load_model(name, path, quantization=quantization, providers=cpu)\nonnx_asr.load_vad('silero', vad, providers=cpu)",
            "gigaam-v3-{variant}",
            "{dir}/gigaam-v3-{variant}",
            "{device}",
            "{quantization}",
            "{dir}/silero-vad"
          ],
          "title": "Загрузка модели и VAD"
        }
      ]
    }
  },
  "notes": {
    "windows": "Windows и Linux: драйвер NVIDIA с поддержкой CUDA 12.8 (библиотеки CUDA и cuDNN ставятся из pip).",
    "linux": "Windows и Linux: драйвер NVIDIA с поддержкой CUDA 12.8 (библиотеки CUDA и cuDNN ставятся из pip)."
  },
  "models": [],
  "reinstall_on": [
    "device",
    "variant",
    "quantization"
  ]
}
