{
  "id": "silero",
  "service": "tts",
  "title": "Silero v5 (CPU | GPU)",
  "order": 15,
  "description": "Самый быстрый русский синтез: Silero TTS v5, пять голосов, автоматические ударения и «ё», ответ потоком по предложениям. На процессоре быстрее реального времени, видеокарта не нужна. Модель ~150 МБ. Лицензия модели CC BY-NC 4.0 — только некоммерческое использование.",
  "requirements": {
    "gpu": false,
    "vram_gb": 0,
    "disk_gb": 2
  },
  "adapter": "openai",
  "config": {
    "url": "http://127.0.0.1:{port}/v1/audio/speech",
    "model": "silero-{model_version}",
    "voice": "{voice}",
    "response_format": "pcm_f32le"
  },
  "voice_modes": [
    "preset"
  ],
  "fields": [
    {
      "key": "voice",
      "label": "Голос",
      "type": "select",
      "options": [
        {
          "value": "aidar",
          "label": "Айдар (муж.)"
        },
        {
          "value": "baya",
          "label": "Бая (жен.)"
        },
        {
          "value": "kseniya",
          "label": "Ксения (жен.)"
        },
        {
          "value": "xenia",
          "label": "Ксения 2, xenia (жен.)"
        },
        {
          "value": "eugene",
          "label": "Евгений (муж.)"
        }
      ]
    },
    {
      "key": "device",
      "label": "Устройство",
      "type": "select",
      "options": [
        {
          "value": "cpu",
          "label": "Процессор (CPU)"
        },
        {
          "value": "cuda",
          "label": "Видеокарта NVIDIA (CUDA)"
        }
      ]
    },
    {
      "key": "gpu",
      "label": "Видеокарта",
      "type": "select",
      "options_from": "gpus",
      "when": {
        "device": "cuda"
      }
    },
    {
      "key": "rate",
      "label": "Частота синтеза",
      "type": "select",
      "options": [
        {
          "value": "24000",
          "label": "24 кГц"
        },
        {
          "value": "48000",
          "label": "48 кГц: качество выше, медленнее"
        },
        {
          "value": "8000",
          "label": "8 кГц: телефонное"
        }
      ],
      "group": "advanced"
    },
    {
      "key": "accent",
      "label": "Автоматические ударения",
      "type": "select",
      "options": [
        {
          "value": "1",
          "label": "Включено"
        },
        {
          "value": "0",
          "label": "Выключено"
        }
      ],
      "group": "advanced"
    },
    {
      "key": "yo",
      "label": "Восстанавливать «ё»",
      "type": "select",
      "options": [
        {
          "value": "1",
          "label": "Включено"
        },
        {
          "value": "0",
          "label": "Выключено"
        }
      ],
      "group": "advanced"
    },
    {
      "key": "model_version",
      "label": "Версия модели",
      "type": "select",
      "options": [
        {
          "value": "v5_6_ru",
          "label": "v5_6 (новая)"
        },
        {
          "value": "v5_ru",
          "label": "v5 (первая)"
        }
      ],
      "group": "advanced"
    },
    {
      "key": "threads",
      "label": "Потоков процессора",
      "type": "number",
      "step": 1,
      "group": "advanced"
    },
    {
      "key": "workers",
      "label": "Параллельных запросов",
      "type": "number",
      "step": 1,
      "group": "advanced"
    },
    {
      "key": "priority",
      "label": "Приоритет процесса",
      "type": "select",
      "options": [
        {
          "value": "normal",
          "label": "Обычный"
        },
        {
          "value": "low",
          "label": "Низкий (фоновый)"
        }
      ],
      "group": "advanced"
    },
    {
      "key": "port",
      "label": "Порт",
      "type": "number",
      "step": 1,
      "group": "advanced"
    }
  ],
  "defaults": {
    "voice": "xenia",
    "device": "cpu",
    "gpu": "0",
    "rate": "24000",
    "accent": "1",
    "yo": "1",
    "model_version": "v5_6_ru",
    "threads": 4,
    "workers": 1,
    "priority": "normal",
    "port": 5019
  },
  "server": {
    "script": "tools/silero_server.py",
    "health": "/health",
    "env": {
      "SILERO_MODEL": "{model_version}",
      "SILERO_MODEL_PATH": "{dir}/{model_version}.pt",
      "SILERO_VOICE": "{voice}",
      "SILERO_RATE": "{rate}",
      "SILERO_ACCENT": "{accent}",
      "SILERO_YO": "{yo}",
      "SILERO_DEVICE": "{device}",
      "SILERO_THREADS": "{threads}",
      "SILERO_WORKERS": "{workers}",
      "CUDA_VISIBLE_DEVICES": "{gpu}"
    }
  },
  "platforms": {
    "windows": {
      "cpu": [
        {
          "pip": [
            "torch==2.9.1",
            "torchaudio==2.9.1"
          ],
          "args": [
            "--index-url",
            "https://download.pytorch.org/whl/cpu"
          ]
        },
        {
          "pip": [
            "scipy==1.18.1",
            "numpy==2.5.4",
            "aiohttp==3.14.5"
          ]
        }
      ],
      "cuda": [
        {
          "pip": [
            "torch==2.9.1",
            "torchaudio==2.9.1"
          ],
          "args": [
            "--index-url",
            "https://download.pytorch.org/whl/cu126"
          ]
        },
        {
          "pip": [
            "scipy==1.18.1",
            "numpy==2.5.4",
            "aiohttp==3.14.5"
          ]
        }
      ]
    },
    "linux": {
      "cpu": [
        {
          "pip": [
            "torch==2.9.1",
            "torchaudio==2.9.1"
          ],
          "args": [
            "--index-url",
            "https://download.pytorch.org/whl/cpu"
          ]
        },
        {
          "pip": [
            "scipy==1.18.1",
            "numpy==2.5.4",
            "aiohttp==3.14.5"
          ]
        }
      ],
      "cuda": [
        {
          "pip": [
            "torch==2.9.1",
            "torchaudio==2.9.1"
          ],
          "args": [
            "--index-url",
            "https://download.pytorch.org/whl/cu126"
          ]
        },
        {
          "pip": [
            "scipy==1.18.1",
            "numpy==2.5.4",
            "aiohttp==3.14.5"
          ]
        }
      ]
    }
  },
  "notes": {
    "windows": "Нужен драйвер NVIDIA с поддержкой CUDA 12.6.",
    "linux": "Нужен драйвер NVIDIA с поддержкой CUDA 12.6."
  },
  "models": [
    {
      "url": "https://models.silero.ai/models/tts/ru/{model_version}.pt"
    }
  ],
  "reinstall_on": [
    "device",
    "model_version"
  ]
}
